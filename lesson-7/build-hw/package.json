{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:esbuild:dev": "npx tsx esbuild.app.config.ts dev",
    "build:esbuild:dev:watch": "npx tsx esbuild.app.config.ts dev --watch",
    "build:esbuild:prod": "npx tsx esbuild.app.config.ts prod",
    "build:esbuild:lib": "npx tsx esbuild.lib.config.ts lib",
    "build:swc:lib": "swc src -d dist/lib-swc/swc",
    "fix:eslint": "eslint --fix --ext .ts,.tsx ./src --max-warnings 0",
    "lint": "eslint .",
    "preview": "vite preview",
    "ncu:list": "ncu",
    "ncu:interactive": "ncu -i"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "ky": "1.14.3",
    "react": "19.2.4",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "react-router": "7.13.1",
    "react-toastify": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@feature-sliced/eslint-config": "0.1.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.12",
    "@swc/wasm": "~1.16.0",
    "@types/node": "~25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "esbuild": "~0.28.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "npm-check-updates": "19.6.3",
    "prettier": "3.8.1",
    "sass-embedded": "1.98.0",
    "tsx": "~4.23.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "*",
    "@rolldown/binding-darwin-x64": "*",
    "@rolldown/binding-linux-x64-gnu": "*"
  }
}