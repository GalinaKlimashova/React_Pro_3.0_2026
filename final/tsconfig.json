{
	"compilerOptions": {
		"target": "ES5",
		"module": "ESNext",
		"moduleResolution": "node",
		"baseUrl": "src",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"jsx": "react-jsx",
		"isolatedModules": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"allowJs": true,
		"plugins": [
			{
				"name": "typescript-plugin-css-modules"
			}
		],
		"paths": {
			"@app": ["1-app"],
			"@pages/*": ["2-pages/*"],
			"@widgets/*": ["3-widgets/*"],
			"@features/*": ["4-features/*"],
			"@shared/*": ["6-shared/*"]
		}
	},
	"outDir": "./dist/",
	"include": [
		"src/**/*"
	]
}